# Copy this file to .env.local-ci for machine-local Local CI overrides.
# Local CI loads .env.local-ci automatically.

# Set this if your repo has no origin remote and Local CI prints
# `No such remote 'origin'` while trying to infer owner/repo.
# GITHUB_REPO=your-org/your-repo

# Set this if runner containers need a different hostname to reach the DTU host.
# LOCAL_CI_DTU_HOST=host.docker.internal

# Set this if Local CI needs a different Docker socket than /var/run/docker.sock.
# LOCAL_CI_DOCKER_HOST=unix:///path/to/docker.sock

# Override Docker extra-host mappings when your local Docker setup needs it.
# LOCAL_CI_DOCKER_EXTRA_HOSTS=host.docker.internal:host-gateway
