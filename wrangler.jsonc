{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kirjolab",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-18",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AUTH_MODE": "access",
    "ACCESS_TEAM_DOMAIN": "https://survivejs.cloudflareaccess.com",
    "ACCESS_AUD": "312f732f4a74d422f56b4c8a39b8da4883245a93b72b61eb8e9c890cbb4f4a90",
    "CROSSREF_MAILTO": "",
    "GITHUB_APP_ID": "4313375",
    "GITHUB_APP_CLIENT_ID": "Iv23liaAOSbgwDC77xsz",
    "GITHUB_APP_SLUG": "kirjolab-sync-bebraw",
  },
  "build": {
    "command": "npm run build",
    "watch_dir": "src",
  },
  "assets": {
    "directory": "./.generated/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      { "name": "DOCUMENT_ROOMS", "class_name": "DocumentRoom" },
      { "name": "WORKSPACE_CATALOGS", "class_name": "WorkspaceCatalog" },
      { "name": "REVIEW_CATALOGS", "class_name": "ReviewCatalog" },
      { "name": "PROJECT_TEMPLATE_CATALOGS", "class_name": "ProjectTemplateCatalog" },
      { "name": "REVIEW_STUDIES", "class_name": "ReviewStudy" },
      { "name": "REVIEW_ACCESS", "class_name": "ReviewAccess" },
      { "name": "WORKSPACE_ACCESS", "class_name": "WorkspaceAccess" },
      { "name": "REFERENCE_LIBRARIES", "class_name": "ReferenceLibrary" },
      { "name": "BACKUP_COORDINATOR", "class_name": "BackupCoordinator" },
      { "name": "BACKUP_RECOVERIES", "class_name": "BackupRecovery" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DocumentRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["WorkspaceCatalog"] },
    { "tag": "v3", "new_sqlite_classes": ["WorkspaceAccess"] },
    { "tag": "v4", "new_sqlite_classes": ["ReferenceLibrary"] },
    { "tag": "v5", "new_sqlite_classes": ["BackupCoordinator"] },
    { "tag": "v6", "new_sqlite_classes": ["BackupRecovery"] },
    { "tag": "v7", "new_sqlite_classes": ["ProjectTemplateCatalog"] },
    { "tag": "v8", "new_sqlite_classes": ["ReviewStudy"] },
    { "tag": "v9", "new_sqlite_classes": ["ReviewCatalog", "ReviewAccess"] },
  ],
  "triggers": { "crons": ["17 2 * * *"] },
  "browser": { "binding": "ARTIFACT_ANALYSIS_BROWSER" },
  "ai": { "binding": "AI" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "queues": {
    "producers": [{ "binding": "ARTIFACT_ANALYSIS_QUEUE", "queue": "kirjolab-artifact-analysis" }],
    "consumers": [
      {
        "queue": "kirjolab-artifact-analysis",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 4,
      },
    ],
  },
  "limits": { "cpu_ms": 300000 },
  "r2_buckets": [{ "binding": "PAPERS", "bucket_name": "kirjolab-papers" }],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.css", "**/*.txt"],
      "fallthrough": true,
    },
  ],
}
