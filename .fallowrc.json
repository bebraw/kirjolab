{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/**/*.e2e.ts",
    "src/browser/pdf-artifact-analyzer.ts",
    "src/client/app.ts",
    "src/client/review-app.ts",
    "src/client/service-worker.ts",
    "src/test-support/cloudflare-workers.ts",
    "scripts/citation-provider-diagnostics-entry.ts",
    "scripts/codemirror-parity-spike.ts",
    "scripts/pdf-reference-quality-entry.ts"
  ],
  "ignorePatterns": ["worker-configuration.d.ts"],
  "ignoreDependencies": [
    "@codemirror/autocomplete",
    "@codemirror/commands",
    "@codemirror/lang-markdown",
    "@codemirror/state",
    "@codemirror/view",
    "@replit/codemirror-vim",
    "@stryker-mutator/api",
    "@unified-latex/unified-latex-util-parse",
    "chrome-launcher",
    "lighthouse",
    "mdast-util-directive",
    "typescript-7",
    "wrangler",
    "y-codemirror.next",
    "y-protocols"
  ],
  "duplicates": {
    "ignore": ["**/*.test.ts", "**/*.test.mts", "**/*.test.mjs", "**/*.e2e.ts"]
  },
  "health": {
    "ignore": ["**/*.test.ts", "**/*.test.mts", "**/*.test.mjs", "**/*.e2e.ts"]
  },
  "typeAware": {
    "enabled": false,
    "projects": ["tsconfig.json", "tsconfig.client.json", "tsconfig.workers-test.json"],
    "require": "best-effort"
  },
  "usedClassMembers": [
    { "extends": "DurableObject", "members": ["*"] },
    { "extends": "LightDomElement", "members": ["properties"] }
  ]
}
