diff --git a/scripts/check-adr-registry.mjs b/scripts/check-adr-registry.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/check-adr-registry.mjs
@@ -0,0 +1,29 @@
+import { readFile, readdir } from "node:fs/promises";
+
+const root = new URL("..", import.meta.url);
+const adrRoot = new URL("docs/adrs/", root);
+const index = await readFile(new URL("README.md", adrRoot), "utf8");
+const seen = new Map();
+const errors = [];
+for (const directory of ["proposed", "accepted", "implemented"]) {
+  for (const name of await readdir(new URL(`${directory}/`, adrRoot))) {
+    if (!name.endsWith(".md")) continue;
+    const content = await readFile(new URL(`${directory}/${name}`, adrRoot), "utf8");
+    const id = /^ADR-(\d{3})-[a-z0-9-]+\.md$/u.exec(name)?.[1];
+    if (!id) errors.push(`${directory}/${name}: invalid filename`);
+    else if (seen.has(id)) errors.push(`ADR-${id}: duplicate identifier`);
+    else seen.set(id, name);
+    if (id && !content.startsWith(`# ADR-${id}: `)) errors.push(`${directory}/${name}: mismatched heading`);
+    if (!/^\*\*Status:\*\* .+$/mu.test(content)) errors.push(`${directory}/${name}: missing status`);
+    if (id !== "000" && !/^\*\*Date:\*\* \d{4}-\d{2}-\d{2}$/mu.test(content)) errors.push(`${directory}/${name}: missing date`);
+    const target = `./${directory}/${name}`;
+    const entries = [...index.matchAll(/^\| \[ADR-\d{3}\]\((\.\/[^)]+)\)/gmu)].filter((match) => match[1] === target);
+    if (entries.length !== 1) errors.push(`${directory}/${name}: expected one index entry`);
+  }
+}
+if (errors.length) {
+  console.error(errors.join("\n"));
+  process.exitCode = 1;
+} else {
+  console.log("ADR registry is consistent.");
+}
